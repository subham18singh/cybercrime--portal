# ========================================================
# CYBERSHIELD AI - Backend Environment Template
# Copy this file to .env (or .env.local) and fill in your keys
# ========================================================

# Server Port (Default: 3000)
PORT=3000
NODE_ENV=development

# Groq API Key (Ultra-fast LLaMA 3.3 / 3.1 inference)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Optional fallback)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Connection String (Optional - falls back to in-memory session store)
MONGODB_URI=mongodb://localhost:27017/cybershield

# JWT Secret for Session Authentication
JWT_SECRET=cybershield_super_secure_jwt_secret_key_2026

# VirusTotal API Key for URL/Hash threat scanner (Optional)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Frontend Application Origin
FRONTEND_URL=http://localhost:5173
